{
  "name": "altruvex-bun",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "rm -rf apps/www/.next apps/admin/.next",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "validate:pricing": "node scripts/validate-pricing-literals.mjs",
    "report:pricing": "bun scripts/pricing-parity-report.mjs",
    "validate": "node scripts/validate-pricing-literals.mjs && bun scripts/pricing-parity-report.mjs && bun scripts/verify-billing-cycles.ts",
    "verify:rendered": "node scripts/verify-rendered-pricing.mjs",
    "verify:cycles": "bun scripts/verify-billing-cycles.ts"
  },
  "devDependencies": {
    "@repo/pricing-schema": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.10.12",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.28",
    "browserslist": "^4.28.9",
    "baseline-browser-mapping": "^2.11.23",
    "fast-uri": "^3.1.6",
    "brace-expansion": "^5.0.12",
    "js-yaml": "^3.15.0",
    "smol-toml": "^1.8.0",
    "dompurify": "^3.4.15",
    "image-size": "^2.0.4",
    "mysql2": "^3.24.4",
    "serialize-javascript": "^7.1.1",
    "deepmerge-ts": "^8.0.2"
  }
}
