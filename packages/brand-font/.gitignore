sources/*
!sources/.gitkeep
.venv/
__pycache__/
.pytest_cache/
# Proof screenshots are regenerated by tools/*.py; only the JSON measurements are committed.
proofs/**/*.png
# The root .gitignore drops every dist/. The font builds are what the apps import (web + og
# through package.json exports, desktop through apps/admin/lib/soffice-fonts.ts), and CI has
# no uv/Python to rebuild them, so those folders are committed. Reports stay local.
!dist/
dist/*
!dist/web/
!dist/og/
!dist/desktop/
