{
  "name": "@repo/brand-font",
  "version": "0.1.0",
  "private": true,
  "description": "Altruvex Sans (Track A): interim OFL derivative of Outfit and Vazirmatn. Python tooling runs through uv.",
  "license": "OFL-1.1",
  "files": [
    "dist/web",
    "dist/og",
    "licenses"
  ],
  "exports": {
    "./fallback.css": "./dist/web/fallback.css",
    "./tokens.css": "./dist/web/tokens.css",
    "./dist/web/*": "./dist/web/*",
    "./dist/og/*": "./dist/og/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "font:fetch": "uv run python tools/fetch.py",
    "font:build": "uv run python tools/build.py",
    "font:desktop": "uv run python tools/desktop.py",
    "font:fallback": "uv run python tools/fallback.py --browser",
    "font:test": "uv run pytest -q"
  }
}
