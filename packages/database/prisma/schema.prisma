generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  // Bare specifiers so the generated client resolves both from TypeScript
  // source (Turbopack transpiles this package via `transpilePackages`) and
  // from the compiled `dist/` output. A ".js" extension only resolves once
  // compiled, which makes a missing `dist/` a hard module-not-found.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id    String   @id @default(uuid())
  email String   @unique
  name  String?
  image String?
  role  UserRole @default(USER)

  emailVerified Boolean   @default(false)
  verifiedAt    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  /// Better Auth two-factor plugin. Set true only after a TOTP code verifies.
  twoFactorEnabled Boolean? @default(false)

  contactSubmissions ContactSubmission[]
  assignedContacts   ContactSubmission[] @relation("AssignedTo")
  meetings           Meeting[]
  meetingRequests    Meeting[]           @relation("RequestedBy")
  notes              ContactNote[]
  sessions           Session[]
  accounts           Account[]
  activityEvents     ActivityEvent[]
  ownedIncidents     Incident[]          @relation("IncidentOwner")
  incidentUpdates    IncidentUpdate[]
  assignedTasks      ProjectTask[]       @relation("TaskAssignee")
  twoFactors         TwoFactor[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better Auth two-factor plugin (TOTP + backup codes). `secret` and
/// `backupCodes` are encrypted with BETTER_AUTH_SECRET by the plugin before
/// they reach this table; never select them into a response.
model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

/// Better Auth's own rate limiter (`rateLimit.storage: "database"`). Kept in
/// the database rather than in memory because every serverless instance would
/// otherwise count sign-in attempts separately. Distinct from
/// RateLimitBucket, which the application's public endpoints use.
model AuthRateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum SubmissionStatus {
  NEW
  VIEWED
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  SPAM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceType {
  WEB_DEVELOPMENT
  ECOMMERCE
  MULTILINGUAL
  UI_UX
  OTHER
}

enum ProjectTimeline {
  IMMEDIATE
  SOON
  PLANNING
  EXPLORING
}

enum BudgetRange {
  UNDER_10K
  B_10K_25K
  B_25K_50K
  OVER_50K
}

model ContactSubmission {
  id              String           @id @default(uuid())
  name            String
  phone           String
  message         String
  serviceInterest ServiceType?
  projectTimeline ProjectTimeline?
  budget          BudgetRange?

  status   SubmissionStatus @default(NEW)
  priority Priority         @default(MEDIUM)

  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  locale      String  @default("en")
  userAgent   String?
  ipAddress   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  notes    ContactNote[]
  tags     ContactTag[]
  meetings Meeting[]

  client Client?

  submittedAt      DateTime  @default(now())
  lastUpdatedAt    DateTime  @updatedAt
  firstViewedAt    DateTime?
  firstContactedAt DateTime?

  @@index([phone])
  @@index([status])
  @@index([priority])
  @@index([submittedAt])
  @@index([assignedToId])
  @@map("contact_submissions")
}

model ContactNote {
  id      String @id @default(uuid())
  content String
  type    String @default("internal")

  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@map("contact_notes")
}

model ContactTag {
  id   String @id @default(uuid())
  name String

  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  createdAt DateTime @default(now())

  @@unique([submissionId, name])
  @@index([name])
  @@map("contact_tags")
}

enum MeetingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum MeetingType {
  DISCOVERY
  CONSULTATION
  PROPOSAL
  FOLLOWUP
}

model Meeting {
  id String @id @default(uuid())

  title       String
  description String?
  type        MeetingType   @default(DISCOVERY)
  status      MeetingStatus @default(PENDING)

  scheduledDate   DateTime
  scheduledTime   String
  durationMinutes Int      @default(30)

  requestedBy   User?   @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedById String?

  assignedTo   User?   @relation(fields: [assignedToId], references: [id])
  assignedToId String?

  contactSubmission ContactSubmission? @relation(fields: [submissionId], references: [id])
  submissionId      String?

  guestName  String?
  guestEmail String?

  meetingUrl String?

  notes      String?
  adminNotes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  completedAt DateTime?

  @@index([scheduledDate])
  @@index([status])
  @@index([assignedToId])
  @@index([submissionId])
  @@map("meetings")
}

enum NotificationType {
  NEW_CONTACT
  NEW_MEETING
  STATUS_CHANGE
  ASSIGNMENT
  /// A client service (domain, hosting, …) crossed an expiry threshold.
  RENEWAL_DUE
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String

  userId String

  entityType String
  entityId   String

  read   Boolean   @default(false)
  readAt DateTime?

  /// Set by writers that must notify once per fact rather than once per run —
  /// the renewal sweep keys it on service + expiry date + threshold, so a
  /// sweep that runs every hour still writes one "expires in 7 days" line.
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

/// A visitor who ran the public estimator and asked for the scoped brief.
///
/// The estimator asks five questions; until now only three of the answers were
/// kept. `brandIdentity` and `contentReadiness` are the two that say how much
/// groundwork a deal carries before engineering starts, so a lead that arrives
/// without them cannot be routed or priced for effort — they are recorded here
/// alongside the rest.
///
/// `reference` is the handle the estimate is discussed by: it is shown to the
/// visitor on the result panel and quoted in the WhatsApp hand-off, so a
/// conversation that starts in a chat window can be tied back to the exact
/// answers that produced the range.
model TransparencyLead {
  id               String    @id @default(uuid())
  reference        String    @unique
  phone            String
  name             String?
  email            String?
  company          String?
  projectType      String
  complexity       String
  timeline         String
  /// "complete" | "partial" | "scratch" — how much of the identity exists.
  brandIdentity    String?
  /// "provide" | "need-help" | "unsure" — how much copy work the build carries.
  contentReadiness String?
  priceMin         Int
  priceMax         Int
  weeksMin         Int
  weeksMax         Int
  locale           String    @default("en")
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  convertedAt      DateTime?
  createdAt        DateTime  @default(now())

  client Client?

  @@index([phone])
  @@index([createdAt])
  @@map("transparency_leads")
}

enum ClientSource {
  WEBSITE_CONTACT_FORM
  TRANSPARENCY_ESTIMATOR
  MANUAL
  WHATSAPP_INBOUND
  REFERRAL
}

model Client {
  id       String  @id @default(uuid())
  name     String?
  phone    String
  email    String?
  company  String?
  industry String?

  source  ClientSource @default(MANUAL)
  addedBy String?

  // Canonical pipeline stage for this client, pre-proposal. Proposal/Contract
  // status (once those exist) take over as the stage for later funnel steps;
  // this is the only stage field for MANUAL/TRANSPARENCY_ESTIMATOR clients,
  // which have no ContactSubmission to source a status from.
  status   SubmissionStatus @default(NEW)
  priority Priority         @default(MEDIUM)

  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])
  contactSubmissionId String?            @unique

  transparencyLead   TransparencyLead? @relation(fields: [transparencyLeadId], references: [id])
  transparencyLeadId String?           @unique

  proposals     Proposal[]
  contracts     Contract[]
  projects      Project[]
  messages      WhatsAppMessage[]
  emails        EmailMessage[]
  subscriptions MaintenanceSubscription[]
  products      Product[]
  services      ClientService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([priority])
  @@map("clients")
}

enum ProposalStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ColorWorld {
  BLUE
  ORANGE
  GREEN
  NONE
}

model Proposal {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  projectType   String
  complexity    String
  currency      String @default("EGP")
  totalPrice    Int
  lineItems     Json
  timelineWeeks Int
  paymentSplit  Json   @default("{\"first\":50,\"second\":30,\"final\":20}")

  colorWorld ColorWorld @default(BLUE)
  accentName String

  // Full editable proposal content — every string the deck renders, per
  // client. Shape and validation live in apps/admin/lib/proposal-schema.ts.
  // The scalar columns above stay populated (derived from this document on
  // save) because the contract builder and the signing flow read them.
  content Json?

  fileUrl String?
  pdfUrl  String?

  status            ProposalStatus @default(DRAFT)
  sentAt            DateTime?
  whatsappMessageId String?
  deliveredAt       DateTime?
  readAt            DateTime?
  respondedAt       DateTime?

  validUntil DateTime

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?
  services ClientService[]

  @@index([clientId])
  @@index([status])
  @@map("proposals")
}

/// Company-wide branding and contact details. Shared by every proposal —
/// deliberately NOT per-client: the deck's visual system is fixed and only
/// its content varies. Single row, id "default".
model CompanySettings {
  id String @id @default("default")

  phone   String
  email   String
  website String

  // The one brand accent, in its light-surface and dark-surface forms.
  // Changing these is a company-wide branding decision, not a per-client one.
  brandColor     String @default("0E51AA")
  brandColorDark String @default("3687F2")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

enum SignVerificationChannel {
  WHATSAPP
  EMAIL
}

enum SignatureMethod {
  CLICK_TO_SIGN
  UPLOADED_PDF
  ESIGN_API
}

model Contract {
  id         String   @id @default(uuid())
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  proposalId String   @unique
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String

  signToken          String?   @unique
  /// After this instant the sign link refuses to sign. Set at creation and
  /// renewed when the contract is sent; null only on rows that predate it.
  signTokenExpiresAt DateTime?

  fileUrl       String?
  signedFileUrl String?

  status          ContractStatus   @default(DRAFT)
  signatureMethod SignatureMethod?
  signedAt        DateTime?
  signedByName    String?
  signedIp        String?

  /// The person allowed to sign. Null falls back to the client record's
  /// contact, so a contract always has someone a code can be sent to.
  signerName  String?
  signerPhone String?
  signerEmail String?

  /// One-time code a signer must enter before the link accepts a signature.
  /// Only the SHA-256 is stored, so nobody reading the row can sign with it.
  signCodeHash      String?
  signCodeExpiresAt DateTime?
  signCodeSentAt    DateTime?
  signCodeAttempts  Int                      @default(0)
  signCodeChannel   SignVerificationChannel?

  /// Where the code that authorised the signature was delivered.
  signerVerifiedVia SignVerificationChannel?
  signerVerifiedTo  String?

  onboardingMessageSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?

  @@index([clientId])
  @@index([status])
  @@map("contracts")
}

enum ProjectPhase {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  QA
  STAGING_REVIEW
  LAUNCHED
  POST_LAUNCH_SUPPORT
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id         String   @id @default(uuid())
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId String   @unique
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String

  portalToken String @unique @default(uuid())

  name   String
  phase  ProjectPhase  @default(DISCOVERY)
  status ProjectStatus @default(ACTIVE)

  stagingUrl String?
  liveUrl    String?

  targetLaunchDate DateTime?
  actualLaunchDate DateTime?

  /// When the engagement was closed. Set only by the close-project flow and
  /// cleared when the project is moved back out of COMPLETED, so a COMPLETED
  /// row without it predates the flow rather than contradicting it.
  completedAt DateTime?

  payments       Payment[]
  products       Product[]
  tasks          ProjectTask[]
  changeRequests ChangeRequest[]
  services       ClientService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

enum PaymentMilestone {
  DEPOSIT_50
  MILESTONE_30
  FINAL_20
  /// Billed on delivery of a ChangeRequest — work outside the original contract.
  CHANGE_REQUEST
  /// One term of a ClientService (domain, hosting…) — opened when the service
  /// is registered without a first term in the fee, and on every renewal.
  SERVICE_RENEWAL
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model Payment {
  id        String  @id @default(uuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  milestone PaymentMilestone
  amount    Int
  status    PaymentStatus    @default(PENDING)

  dueDate   DateTime?
  paidAt    DateTime?
  method    String?
  reference String?

  /// Set when this payment bills a delivered change request.
  changeRequest ChangeRequest?

  /// Set when this payment bills one term of a client service. Many per
  /// service — one per term. Survives the service being deleted.
  service   ClientService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([serviceId])
  @@map("payments")
}

/// Where a change request is in its life. Transitions are enforced in
/// apps/admin/lib/change-requests.ts, not by the database.
enum ChangeRequestStatus {
  REQUESTED
  QUOTED
  APPROVED
  IN_PROGRESS
  DELIVERED
  DECLINED
  CANCELLED
}

/// How the work is charged. WARRANTY is free and only valid inside the
/// post-launch warranty window.
enum ChangeRequestPricing {
  HOURLY
  FIXED
  WARRANTY
}

/// A one-off modification to a project the client pays for separately — the
/// path for a client with no maintenance retainer. It hangs off the Project
/// (not a subscription, not a new contract), so a small edit does not need a
/// new proposal → contract → project chain, and a closed project can still
/// take one without being reopened.
model ChangeRequest {
  id String @id @default(uuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title  String
  detail String?

  status  ChangeRequestStatus   @default(REQUESTED)
  pricing ChangeRequestPricing?

  /// Hours are stored as whole minutes so a quarter hour stays exact.
  estimatedMinutes Int?
  actualMinutes    Int?

  /// The hourly rate at the moment of quoting. Snapshotted so a later edit on
  /// /pricing cannot re-price work the client already agreed to.
  hourlyRate Int?

  /// What the client agreed to. Currency is the project's (payment → project
  /// → contract → proposal), exactly as for Payment.
  quotedAmount Int?
  /// What was billed on delivery. For HOURLY it follows the actual hours.
  billedAmount Int?

  /// The client's link to review and answer the quote (`/quote/[token]`).
  /// Unguessable, scoped to this one request, and kept across re-quotes so a
  /// link already in the client's inbox keeps showing the current number.
  quoteToken     String?   @unique
  /// When the CURRENT quote was sent. A re-quote clears it: the link then
  /// refuses an answer until the new number has actually been sent.
  quoteSentAt    DateTime?
  /// "email" or "whatsapp".
  quoteSentVia   String?
  quoteExpiresAt DateTime?
  /// First time the client opened the sent quote. Evidence, not a guess.
  quoteViewedAt  DateTime?
  /// Who answered on the quote page, and anything they wrote.
  respondedByName    String?
  clientResponseNote String?

  requestedAt DateTime  @default(now())
  quotedAt    DateTime?
  approvedAt  DateTime?
  startedAt   DateTime?
  deliveredAt DateTime?
  closedAt    DateTime?

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId String?  @unique

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("change_requests")
}

enum WhatsAppDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppMessage {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  direction WhatsAppDirection
  status    WhatsAppMessageStatus @default(QUEUED)

  waMessageId  String? @unique
  templateName String?
  body         String
  mediaUrl     String?

  relatedProposalId String?
  relatedContractId String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([waMessageId])
  @@map("whatsapp_messages")
}

/// One row per webhook delivery that was accepted. A signed delivery replayed
/// later carries the same provider id, hits the unique index, and is refused
/// instead of rewriting state that has since moved on.
model WebhookDelivery {
  id         String   @id @default(uuid())
  provider   String
  deliveryId String
  receivedAt DateTime @default(now())

  @@unique([provider, deliveryId])
  @@index([receivedAt])
  @@map("webhook_deliveries")
}

model RateLimitBucket {
  id            String   @id @default(uuid())
  key           String   @unique
  windowStart   DateTime
  windowSeconds Int
  count         Int      @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Pricing overrides
//
// `@repo/pricing-schema` holds the typed contract and the shipped defaults;
// these tables hold only what an admin has actually changed. Resolution is
// `override ?? default`, so an empty table renders exactly what the last
// deploy shipped and a database outage degrades to those values rather than
// taking prices off the marketing site.
//
// Only commercially meaningful fields live here. Bilingual names and
// descriptions stay in the schema package alongside the numbers they describe.
// ---------------------------------------------------------------------------

/// One cell of the service price matrix: a (service, complexity) pair.
model PricingCellOverride {
  serviceId    String
  complexityId String

  priceMin Int
  priceMax Int
  weeksMin Int
  weeksMax Int

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([serviceId, complexityId])
  @@map("pricing_cell_overrides")
}

model MaintenancePlanOverride {
  id String @id

  /// Null means quote-only; the plan renders as "Custom" and shows no figure.
  price                  Int?
  requestsPerCycle       Int?
  overageHourlyRate      Int?
  /// Internal margin planning. Never rendered on a client surface.
  internalHourEquivalent Int?
  status                 String @default("active")

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_plan_overrides")
}

model ConsultingPackageOverride {
  id String @id

  price                Int
  durationBusinessDays Int
  status               String @default("active")

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consulting_package_overrides")
}

model AddonOverride {
  id String @id

  /// Null while the real supplier cost is not on file. A null-cost add-on is
  /// never priced and never shown to a client.
  costBasis    Int?
  markupType   String @default("percent")
  markupValue  Int    @default(0)
  billingCycle String @default("annual")
  status       String @default("planned")

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addon_overrides")
}

/// Singleton. VAT, revision rate, milestone split, and the fixed USD rate.
model CommercialTermsOverride {
  id String @id @default("default")

  vatRate                Float
  revisionHourlyRate     Int
  revisionHourlyRateUsd  Int
  includedRevisionRounds Int
  paymentSplitFirst      Int
  paymentSplitSecond     Int
  paymentSplitFinal      Int
  proposalValidityDays   Int
  postLaunchWarrantyDays Int

  usdEgpRate        Int
  usdRateReviewedOn DateTime

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commercial_terms_overrides")
}

/// Append-only record of every pricing change.
///
/// A published price is a commitment a client can read back, so "what did this
/// cost in March, and who changed it" has to be answerable. The audit found no
/// such record existed.
model PricingChangeLog {
  id String @id @default(uuid())

  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?

  changedBy String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("pricing_change_log")
}

// ---------------------------------------------------------------------------
// Maintenance subscriptions and the client portal
//
// A maintenance retainer is ongoing and belongs to a client, not to one
// project, so it carries its own portal token rather than reusing
// `Project.portalToken` — a client whose project has launched still needs the
// portal, and may hold a retainer covering several projects.
//
// Plan identity (`planId`) is a MaintenancePlanId from @repo/pricing-schema.
// The price, the request cap and the overage rate are NOT copied here: they
// are resolved from the pricing schema at read time, so a plan change reaches
// existing subscribers instead of leaving them on a stale copy.
// ---------------------------------------------------------------------------

enum MaintenanceSubscriptionStatus {
  /// Paid trial period; converts to ACTIVE at `trialEndsAt`.
  TRIALING
  ACTIVE
  /// Renewal date passed, payment not recorded. Service continues.
  PAST_DUE
  /// Past due beyond the grace window. Service continues, escalation is due.
  GRACE
  /// Deliberately halted by Altruvex. Service stopped, subscription retained.
  SUSPENDED
  /// Halted at the client's request but still inside a paid period.
  PAUSED
  CANCELLED
  /// Ran to the end of its final period without renewing.
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MaintenanceRequestStatus {
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model MaintenanceSubscription {
  id String @id @default(uuid())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  /// A MaintenancePlanId from @repo/pricing-schema ("essential", …).
  planId String

  status MaintenanceSubscriptionStatus @default(ACTIVE)

  /// Single-purpose, unguessable portal link. Same posture as
  /// `Project.portalToken`: no password, one client, one URL.
  portalToken String @unique @default(uuid())

  /// Billing anchor. The monthly cycle runs from this day-of-month, so a
  /// subscription started on the 15th caps requests 15th-to-14th.
  startedAt   DateTime  @default(now())
  cancelledAt DateTime?

  billingInterval BillingInterval @default(MONTHLY)

  /// The period currently paid for. `currentPeriodEnd` IS the renewal date —
  /// storing one derived from the other is how the two drift apart.
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  /// False means it runs to `currentPeriodEnd` and then EXPIRES. The renewals
  /// screen sorts on this: a non-renewing subscription is a churn event with a
  /// known date, not a surprise.
  autoRenew Boolean @default(true)

  trialEndsAt DateTime?

  /// Set when a renewal is invoiced/collected, so PAST_DUE is measurable
  /// rather than inferred from silence.
  lastRenewedAt DateTime?

  requests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("maintenance_subscriptions")
}

model MaintenanceRequest {
  id String @id @default(uuid())

  subscription   MaintenanceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String

  title  String
  detail String?

  status MaintenanceRequestStatus @default(SUBMITTED)

  /// Start of the billing cycle this request counts against, stamped at
  /// submission. Storing it rather than deriving it later means a change to
  /// the billing anchor cannot retroactively move a request into another
  /// cycle and silently push a client over their cap.
  cycleStart DateTime

  /// False for work handled as billable overage rather than against the cap —
  /// so the count a client sees always matches what they are charged for.
  countsToCap Boolean @default(true)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, cycleStart])
  @@index([status])
  @@map("maintenance_requests")
}

// ---------------------------------------------------------------------------
// Activity / audit trail
//
// Everything before this model was a *projection*: /activity and /audit read
// `updatedAt` off business rows and inferred that something had happened. That
// can show a row changed but never who changed it, from what, to what — which
// is the only question an audit log exists to answer.
//
// This model is written at the mutation site, not derived after the fact.
// `actorLabel` is denormalised on purpose: an event must stay readable after
// the user who caused it is deleted, and many actors are not Users at all
// (a client signing through a portal token, the WhatsApp webhook, a CI token).
//
// `before`/`after` hold only the fields that actually changed. Never put a
// secret in them — see `redactAuditValue` in packages/database/index.ts.
// ---------------------------------------------------------------------------

enum ActorKind {
  USER
  CLIENT
  SYSTEM
  INTEGRATION
}

model ActivityEvent {
  id String @id @default(uuid())

  /// Dot-namespaced and stable, e.g. "client.created", "deployment.succeeded".
  /// Parsed nowhere — it is grouped and filtered as an opaque string.
  action String

  actorKind  ActorKind @default(SYSTEM)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  /// Survives actor deletion. "Ali", "CI (github-actions)", "client portal".
  actorLabel String

  entityType  String
  entityId    String
  /// Human-readable at the time of the event, so the feed stays legible even
  /// after the entity is renamed or removed.
  entityLabel String?

  /// One line, already written for a human. The feed renders this directly.
  summary String

  /// Changed fields only, redacted. `{ status: "DRAFT" }` → `{ status: "SENT" }`.
  before Json?
  after  Json?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Engineering operations: products, builds, deployments, logs, incidents
//
// A Project is the *engagement* (a contract being delivered). A Product is the
// thing that stays alive afterwards: the site or app Altruvex operates for a
// client. Conflating them is why `Project.stagingUrl`/`liveUrl` could never
// answer "what is deployed right now" — a project ends, a product does not, and
// one engagement can ship several products.
//
// Environment is an enum, not a table: Altruvex runs production/staging/preview
// and nothing else, so a join buys a query cost and no expressiveness.
//
// Nothing in here is written by the UI. Builds, deployments and logs arrive
// from CI through the ingest endpoint (`/api/ingest/*`, bearer-authenticated
// per product). Until a pipeline is pointed at it these tables are empty and
// the screens say so — they are never seeded with plausible-looking rows.
// ---------------------------------------------------------------------------

enum ProductKind {
  WEBSITE
  WEB_APP
  API
  ECOMMERCE
  LANDING_PAGE
  INTERNAL_TOOL
}

enum ProductStatus {
  PLANNED
  IN_DEVELOPMENT
  LIVE
  MAINTENANCE
  SUNSET
}

enum DeployEnvironment {
  PRODUCTION
  STAGING
  PREVIEW
}

model Product {
  id String @id @default(uuid())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  /// Optional: a product can outlive the project that built it, and can exist
  /// before any contract does.
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  name String
  /// URL-safe identity used by the ingest endpoint, so CI does not need a UUID.
  slug String @unique

  kind   ProductKind   @default(WEBSITE)
  status ProductStatus @default(PLANNED)

  productionUrl String?
  stagingUrl    String?
  repositoryUrl String?

  framework       String?
  hostingProvider String?

  /// SHA-256 of the ingest bearer token. The token itself is shown once at
  /// creation and never stored — the UI has nothing to leak.
  ingestTokenHash     String?   @unique
  ingestTokenLast4    String?
  ingestTokenIssuedAt DateTime?

  builds      Build[]
  deployments Deployment[]
  logs        LogEntry[]
  incidents   Incident[]
  services    ClientService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("products")
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Build {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  environment DeployEnvironment @default(PRODUCTION)
  status      BuildStatus       @default(QUEUED)

  /// Monotonic per product, assigned at ingest. What an operator actually says
  /// out loud ("build 41 failed") — a UUID is not that.
  number Int

  /// The CI system's own id for the run. The idempotency key for ingest: a
  /// pipeline posts the same build as it progresses (QUEUED → RUNNING →
  /// SUCCEEDED) and must update one row, not create three.
  externalId String?

  commitSha     String?
  commitMessage String?
  branch        String?

  /// Free text from CI ("github-actions", "ali@altruvex.com"). Not a User FK:
  /// the actor is frequently a machine that has no account here.
  triggeredBy String?

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  /// Why it failed, in one line. The detail belongs in the linked logs.
  failureReason String?

  deployments Deployment[]
  logs        LogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, number])
  @@unique([productId, externalId])
  @@index([productId, createdAt])
  @@index([status])
  @@map("builds")
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

model Deployment {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  build   Build?  @relation(fields: [buildId], references: [id], onDelete: SetNull)
  buildId String?

  environment DeployEnvironment @default(PRODUCTION)
  status      DeploymentStatus  @default(PENDING)

  number Int

  /// Idempotency key from the deploying system, same contract as `Build`.
  externalId String?

  version   String?
  commitSha String?
  url       String?

  triggeredBy String?

  startedAt  DateTime?
  finishedAt DateTime?

  /// Set on the deployment that was rolled back, pointing at the one that
  /// replaced it. Reading "what undid this" is the common direction.
  rolledBackBy   Deployment?  @relation("Rollback", fields: [rolledBackById], references: [id], onDelete: SetNull)
  rolledBackById String?
  rollbackOf     Deployment[] @relation("Rollback")

  failureReason String?

  logs      LogEntry[]
  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, number])
  @@unique([productId, externalId])
  @@index([productId, createdAt])
  @@index([status])
  @@index([environment, createdAt])
  @@map("deployments")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model LogEntry {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  environment DeployEnvironment @default(PRODUCTION)
  level       LogLevel          @default(INFO)

  /// Emitting subsystem: "web", "worker", "build", "edge".
  source  String?
  message String

  /// Ties a log line to the request that produced it, so an operator can pull
  /// the whole trace from one error.
  requestId String?

  /// When the event happened at the source — NOT when it arrived here. Ingest
  /// can lag, and sorting by arrival reorders an incident's timeline.
  timestamp DateTime @default(now())

  build   Build?  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String?

  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  deploymentId String?

  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  incidentId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([productId, timestamp])
  @@index([productId, level, timestamp])
  @@index([buildId, timestamp])
  @@index([deploymentId, timestamp])
  @@index([requestId])
  @@map("log_entries")
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Incident {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  /// The deployment suspected of causing it, when there is one.
  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  deploymentId String?

  number Int

  title  String
  detail String?

  severity IncidentSeverity @default(SEV3)
  status   IncidentStatus   @default(INVESTIGATING)

  owner   User?   @relation("IncidentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  /// Written after the fact. Absent on an unresolved incident.
  resolution String?

  updates IncidentUpdate[]
  logs    LogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, number])
  @@index([status, severity])
  @@index([productId, detectedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id String @id @default(uuid())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String

  /// Status the incident moved to with this update, when it moved at all.
  status IncidentStatus?

  body String

  authorLabel String
  author      User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

// ---------------------------------------------------------------------------
// Delivery tasks
//
// Replaces a screen that synthesised three tasks per project from its phase and
// toasted "Task created successfully" without writing anything. Either the work
// items are real rows an operator can assign and close, or the screen should
// not exist.
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model ProjectTask {
  id String @id @default(uuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title  String
  detail String?

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  /// Phase this task belongs to, so a board can group by delivery stage
  /// instead of inventing its own parallel taxonomy.
  phase ProjectPhase?

  dueDate     DateTime?
  completedAt DateTime?

  /// Manual ordering within a column. Sparse (steps of 1000) so a reorder
  /// touches one row instead of renumbering the board.
  position Int @default(0)

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@map("project_tasks")
}

enum EmailMessageStatus {
  QUEUED
  SENT
  FAILED
  /// Set by a provider webhook, never by this application. Until one is wired
  /// up no row ever reaches these — a status nothing can set is better than one
  /// the UI invents.
  DELIVERED
  BOUNCED
  COMPLAINED
}

/// One outbound email, recorded the way `WhatsAppMessage` records one message.
///
/// Deliberately the same shape: both are a thing sent to a client about a
/// proposal or a contract, and a client's history is worth less if the two
/// channels are stored as different kinds of fact.
model EmailMessage {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  status EmailMessageStatus @default(QUEUED)

  /// The transport's own id — Resend's, or the Message-ID an SMTP server
  /// assigned. What a delivery question quotes.
  providerMessageId String? @unique
  /// Which transport sent it, because one client's history can span a move
  /// from one to the other.
  transport         String

  toAddress String
  subject   String
  body      String

  relatedProposalId String?
  relatedContractId String?

  /// Why the transport refused it, in its own words.
  failureReason String?

  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([providerMessageId])
  @@map("email_messages")
}

// ---------------------------------------------------------------------------
// Client services: domains, hosting, business email and anything else a client
// holds through Altruvex that expires
//
// A project ends; the domain it launched on renews every year. Until this
// existed that renewal lived in someone's memory, and the first sign it was
// forgotten would have been the client's site going dark.
//
// `price` is what the CLIENT pays per term and is entered per service, not
// resolved from @repo/pricing-schema: a registrar's price for one TLD is a fact
// about that one domain, not a published tier. `cost` is what Altruvex pays the
// supplier — internal margin data, never rendered on a client surface.
//
// Stored status is what an operator decided (PENDING until it is actually
// registered, ACTIVE, CANCELLED). Whether an active service is "expiring" or
// "expired" is derived from `expiresAt` and the clock in
// apps/admin/lib/service-lifecycle.ts — the same rule the retainers follow, so
// the renewals screen is correct on a system whose cron has not run.
//
// Never store a registrar or hosting password here. `reference` is an order or
// account id, the thing a support ticket quotes.
// ---------------------------------------------------------------------------

enum ClientServiceKind {
  DOMAIN
  HOSTING
  BUSINESS_EMAIL
  SSL_CERTIFICATE
  SOFTWARE_LICENSE
  OTHER
}

enum ClientServiceStatus {
  /// Agreed (usually through a signed proposal) but not yet registered, so it
  /// has no real expiry date and raises no renewal alert.
  PENDING
  ACTIVE
  CANCELLED
}

model ClientService {
  id String @id @default(uuid())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  /// The engagement it was sold with. Optional: a service outlives its project
  /// and can be added for a client who never had one.
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  /// The site or app it serves, when that product is tracked.
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  /// The proposal whose accepted terms created it. Null for one added by hand.
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalId String?

  kind     ClientServiceKind
  /// "newlight.com", "Vercel Pro", "Google Workspace — 5 seats".
  name     String
  provider String?
  /// Registrar order id or account handle. Never a credential.
  reference String?

  status ClientServiceStatus @default(PENDING)

  currency String @default("EGP")
  /// What the client pays per term.
  price    Int
  /// What Altruvex pays the supplier per term. Internal only.
  cost     Int?
  /// Length of one billing term. 12 for an annual domain, 1 for monthly hosting.
  termMonths Int @default(12)
  /// The first term is covered by the project fee (the contract's "Year 1
  /// included"); billing starts at the first renewal.
  firstTermIncluded Boolean @default(false)
  /// Renews at the provider without anyone acting. Alerts still fire — a
  /// renewal the provider charges is still one the client owes.
  autoRenew Boolean @default(false)

  startedAt     DateTime?
  /// The renewal date. Required once ACTIVE; null only while PENDING.
  expiresAt     DateTime?
  lastRenewedAt DateTime?
  cancelledAt   DateTime?

  /// The expiry date the client was last reminded about, and when. Compared
  /// with `expiresAt` rather than reset on renewal: "reminded this cycle" is
  /// `reminderSentFor == expiresAt`, so a renewal re-arms it without a write.
  reminderSentFor DateTime?
  reminderSentAt  DateTime?

  /// One payment per billed term.
  payments Payment[]

  notes String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status, expiresAt])
  @@map("client_services")
}
