generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id    String   @id @default(uuid())
  email String   @unique
  name  String?
  image String?
  role  UserRole @default(USER)

  emailVerified Boolean   @default(false)
  verifiedAt    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  twoFactorEnabled Boolean? @default(false)

  contactSubmissions ContactSubmission[]
  assignedContacts   ContactSubmission[] @relation("AssignedTo")
  meetings           Meeting[]
  meetingRequests    Meeting[]           @relation("RequestedBy")
  notes              ContactNote[]
  sessions           Session[]
  accounts           Account[]
  activityEvents     ActivityEvent[]
  ownedIncidents     Incident[]          @relation("IncidentOwner")
  incidentUpdates    IncidentUpdate[]
  assignedTasks      ProjectTask[]       @relation("TaskAssignee")
  twoFactors         TwoFactor[]
  clientNotes        ClientNote[]
  ownedClients       Client[]            @relation("ClientOwner")

  opsRole ProductRole?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

model AuthRateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum SubmissionStatus {
  NEW
  VIEWED
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  SPAM
  // Sales machine (2026-10-07): a lead being qualified before it is worth a
  // call, and a lead parked for later follow-up rather than lost.
  QUALIFYING
  NURTURE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceType {
  WEB_DEVELOPMENT
  ECOMMERCE
  MULTILINGUAL
  UI_UX
  TECHNICAL_AUDIT
  MAINTENANCE
  OTHER
}

enum ProjectTimeline {
  IMMEDIATE
  SOON
  PLANNING
  EXPLORING
}

enum BudgetRange {
  // Deprecated (2026-10-07): fixed-currency bands. Kept so old rows still
  // read; new code never writes them. Readers map them for the lead score.
  UNDER_10K
  B_10K_25K
  B_25K_50K
  OVER_50K
  // Multiples of the published minimum engagement (packages/pricing-schema
  // budget bands): [1,2), [2,5), [5,10), [10,inf).
  FLOOR_TO_2X
  X2_TO_5X
  X5_TO_10X
  OVER_10X
  UNSURE
}

enum ProjectSituation {
  NEW_BUILD
  REPLACE_EXISTING
  IMPROVE_EXISTING
  UNSURE
}

enum DecisionRole {
  DECIDES
  SHARED
  ADVISES
}

enum LostReason {
  BUDGET
  TIMING
  FIT
  COMPETITOR
  NO_RESPONSE
  OTHER
}

model ContactSubmission {
  id              String           @id @default(uuid())
  name            String
  phone           String
  // Nullable: rows before 2026-10-05 were collected without one. The www
  // contact form requires it for every new submission.
  email           String?
  message         String
  serviceInterest ServiceType?
  projectTimeline ProjectTimeline?
  budget          BudgetRange?

  status   SubmissionStatus @default(NEW)
  priority Priority         @default(MEDIUM)

  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  locale      String  @default("en")
  userAgent   String?
  ipAddress   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  // First page the visitor landed on this session (path only, no query).
  landingPath String?

  // Optional qualification step answered after a successful submit.
  situation    ProjectSituation?
  decisionRole DecisionRole?
  qualifiedAt  DateTime?

  // One-time follow-up token (qualify step / pre-call brief). Only the
  // sha256 hex is stored; the raw token goes back in the JSON response.
  stepTokenHash      String?   @unique
  stepTokenExpiresAt DateTime?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  notes    ContactNote[]
  tags     ContactTag[]
  meetings Meeting[]

  client Client?

  submittedAt      DateTime  @default(now())
  lastUpdatedAt    DateTime  @updatedAt
  firstViewedAt    DateTime?
  firstContactedAt DateTime?

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([priority])
  @@index([submittedAt])
  @@index([assignedToId])
  @@map("contact_submissions")
}

model ContactNote {
  id      String @id @default(uuid())
  content String
  type    String @default("internal")

  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@map("contact_notes")
}

model ContactTag {
  id   String @id @default(uuid())
  name String

  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  createdAt DateTime @default(now())

  @@unique([submissionId, name])
  @@index([name])
  @@map("contact_tags")
}

/// The decision a discovery/consultation call ended with (docs/sales-os.md R7).
enum CallOutcome {
  PROPOSAL_REQUIRED
  FOLLOW_UP
  NURTURE
  LOST
  NO_FURTHER_ACTION
}

enum MeetingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum MeetingType {
  DISCOVERY
  CONSULTATION
  PROPOSAL
  FOLLOWUP
}

model Meeting {
  id String @id @default(uuid())

  title       String
  description String?
  type        MeetingType   @default(DISCOVERY)
  status      MeetingStatus @default(PENDING)

  scheduledDate   DateTime
  scheduledTime   String
  durationMinutes Int      @default(30)

  requestedBy   User?   @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedById String?

  assignedTo   User?   @relation(fields: [assignedToId], references: [id])
  assignedToId String?

  contactSubmission ContactSubmission? @relation(fields: [submissionId], references: [id])
  submissionId      String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  guestName  String?
  guestEmail String?

  meetingUrl String?

  notes      String?
  adminNotes String?

  // Pre-call brief from the guest: { current, change, stakes }.
  preCallBrief   Json?
  preCallBriefAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  completedAt DateTime?

  // What the call decided, recorded by a person after it (docs/sales-os.md R7).
  // Never inferred: a completed call with no outcome stays "outcome owed".
  outcome   CallOutcome?
  outcomeAt DateTime?

  @@index([scheduledDate])
  @@index([status])
  @@index([assignedToId])
  @@index([submissionId])
  @@index([clientId])
  @@map("meetings")
}

enum NotificationType {
  NEW_CONTACT
  NEW_MEETING
  STATUS_CHANGE
  ASSIGNMENT
  RENEWAL_DUE
  FOLLOW_UP_DUE
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String

  userId String

  entityType String
  entityId   String

  read   Boolean   @default(false)
  readAt DateTime?

  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model TransparencyLead {
  id               String    @id @default(uuid())
  reference        String    @unique
  // Null for an email-only estimate request (no number was given).
  phone            String?
  name             String?
  email            String?
  company          String?
  projectType      String
  complexity       String
  timeline         String
  brandIdentity    String?
  contentReadiness String?
  scopeNotes       String[]  @default([])
  note             String?
  priceMin         Int
  priceMax         Int
  weeksMin         Int
  weeksMax         Int
  locale           String    @default("en")
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  landingPath      String?
  // What the visitor said they were facing before the estimate (the site's
  // intent choice), and the preliminary read the result showed them. Both are
  // recomputed or validated on the server, never trusted from the client.
  situation        ProjectSituation?
  nextStep         String?
  drivers          String[]  @default([])
  convertedAt      DateTime?
  createdAt        DateTime  @default(now())

  client Client?

  @@index([phone])
  @@index([createdAt])
  @@map("transparency_leads")
}

enum ClientSource {
  WEBSITE_CONTACT_FORM
  TRANSPARENCY_ESTIMATOR
  MANUAL
  WHATSAPP_INBOUND
  REFERRAL
  EXIT_INTENT
}

model Client {
  id       String  @id @default(uuid())
  name     String?
  // Null for a client reached by email only (an email-only estimate lead).
  phone    String?
  email    String?
  company  String?
  industry String?

  website      String?
  country      String?
  address      String?
  billingEmail String?
  taxId        String?

  source  ClientSource @default(MANUAL)
  addedBy String?

  status   SubmissionStatus @default(NEW)
  priority Priority         @default(MEDIUM)

  owner          User?       @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId        String?
  nextActionAt   DateTime?
  nextActionNote String?
  lostReason     LostReason?
  lostNote       String?
  // Why a lead is parked in NURTURE; its review date is nextActionAt (docs/sales-os.md R8).
  nurtureReason  LostReason?

  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])
  contactSubmissionId String?            @unique

  transparencyLead   TransparencyLead? @relation(fields: [transparencyLeadId], references: [id])
  transparencyLeadId String?           @unique

  proposals     Proposal[]
  contracts     Contract[]
  projects      Project[]
  messages      WhatsAppMessage[]
  emails        EmailMessage[]
  subscriptions MaintenanceSubscription[]
  products      Product[]
  services      ClientService[]
  notes         ClientNote[]
  meetings      Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@index([nextActionAt])
  @@map("clients")
}

enum ProposalStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ColorWorld {
  BLUE
  ORANGE
  GREEN
  NONE
}

model Proposal {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  projectType   String
  complexity    String
  currency      String @default("EGP")
  totalPrice    Int
  lineItems     Json
  timelineWeeks Int
  paymentSplit  Json   @default("{\"first\":50,\"second\":30,\"final\":20}")

  colorWorld ColorWorld @default(BLUE)
  accentName String

  content Json?

  fileUrl String?
  pdfUrl  String?

  status            ProposalStatus @default(DRAFT)
  sentAt            DateTime?
  whatsappMessageId String?
  deliveredAt       DateTime?
  readAt            DateTime?
  respondedAt       DateTime?

  validUntil DateTime

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?
  services ClientService[]

  @@index([clientId])
  @@index([status])
  @@map("proposals")
}

model CompanySettings {
  id String @id @default("default")

  phone   String
  email   String
  website String

  brandColor     String @default("0E51AA")
  brandColorDark String @default("3687F2")

  invoicePrefix   String @default("INV")
  invoiceSequence Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

enum SignVerificationChannel {
  WHATSAPP
  EMAIL
}

enum SignatureMethod {
  CLICK_TO_SIGN
  UPLOADED_PDF
  ESIGN_API
}

model Contract {
  id         String   @id @default(uuid())
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  proposalId String   @unique
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String

  signToken          String?   @unique
  signTokenExpiresAt DateTime?

  fileUrl       String?
  signedFileUrl String?

  status          ContractStatus   @default(DRAFT)
  signatureMethod SignatureMethod?
  signedAt        DateTime?
  signedByName    String?
  signedIp        String?

  signerName  String?
  signerPhone String?
  signerEmail String?

  signCodeHash      String?
  signCodeExpiresAt DateTime?
  signCodeSentAt    DateTime?
  signCodeAttempts  Int                      @default(0)
  signCodeChannel   SignVerificationChannel?

  signerVerifiedVia SignVerificationChannel?
  signerVerifiedTo  String?

  onboardingMessageSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?

  @@index([clientId])
  @@index([status])
  @@map("contracts")
}

enum ProjectPhase {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  QA
  STAGING_REVIEW
  LAUNCHED
  POST_LAUNCH_SUPPORT
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectOrigin {
  CONTRACT
  RECORDED
}

model Project {
  id         String        @id @default(uuid())
  contract   Contract?     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractId String?       @unique
  origin     ProjectOrigin @default(CONTRACT)
  client     Client        @relation(fields: [clientId], references: [id])
  clientId   String

  portalToken String @unique @default(uuid())

  name   String
  phase  ProjectPhase  @default(DISCOVERY)
  status ProjectStatus @default(ACTIVE)

  currency String?

  stagingUrl String?
  liveUrl    String?

  targetLaunchDate DateTime?
  actualLaunchDate DateTime?

  completedAt DateTime?

  payments       Payment[]
  products       Product[]
  tasks          ProjectTask[]
  changeRequests ChangeRequest[]
  services       ClientService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

enum PaymentMilestone {
  DEPOSIT_50
  MILESTONE_30
  FINAL_20
  CHANGE_REQUEST
  SERVICE_RENEWAL
  RETAINER_RENEWAL
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model Payment {
  id        String   @id @default(uuid())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId String?

  milestone PaymentMilestone
  amount    Int
  status    PaymentStatus    @default(PENDING)

  dueDate   DateTime?
  paidAt    DateTime?
  method    String?
  reference String?

  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  changeRequest ChangeRequest?

  service   ClientService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?

  subscription   MaintenanceSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([serviceId])
  @@index([subscriptionId])
  @@map("payments")
}

enum ChangeRequestStatus {
  REQUESTED
  QUOTED
  APPROVED
  IN_PROGRESS
  DELIVERED
  DECLINED
  CANCELLED
}

enum ChangeRequestPricing {
  HOURLY
  FIXED
  WARRANTY
}

model ChangeRequest {
  id String @id @default(uuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title  String
  detail String?

  status  ChangeRequestStatus   @default(REQUESTED)
  pricing ChangeRequestPricing?

  estimatedMinutes Int?
  actualMinutes    Int?

  hourlyRate Int?

  quotedAmount Int?
  billedAmount Int?

  quoteToken         String?   @unique
  quoteSentAt        DateTime?
  quoteSentVia       String?
  quoteExpiresAt     DateTime?
  quoteViewedAt      DateTime?
  respondedByName    String?
  clientResponseNote String?

  requestedAt DateTime  @default(now())
  quotedAt    DateTime?
  approvedAt  DateTime?
  startedAt   DateTime?
  deliveredAt DateTime?
  closedAt    DateTime?

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId String?  @unique

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("change_requests")
}

enum WhatsAppDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppMessage {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  direction WhatsAppDirection
  status    WhatsAppMessageStatus @default(QUEUED)

  waMessageId  String? @unique
  templateName String?
  body         String
  mediaUrl     String?

  relatedProposalId String?
  relatedContractId String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([waMessageId])
  @@map("whatsapp_messages")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  provider   String
  deliveryId String
  receivedAt DateTime @default(now())

  @@unique([provider, deliveryId])
  @@index([receivedAt])
  @@map("webhook_deliveries")
}

model RateLimitBucket {
  id            String   @id @default(uuid())
  key           String   @unique
  windowStart   DateTime
  windowSeconds Int
  count         Int      @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model PricingCellOverride {
  serviceId    String
  complexityId String

  priceMin Int
  priceMax Int
  weeksMin Int
  weeksMax Int

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([serviceId, complexityId])
  @@map("pricing_cell_overrides")
}

model MaintenancePlanOverride {
  id String @id

  price                  Int?
  requestsPerCycle       Int?
  overageHourlyRate      Int?
  internalHourEquivalent Int?
  status                 String @default("active")

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_plan_overrides")
}

model ConsultingPackageOverride {
  id String @id

  price                Int
  durationBusinessDays Int
  status               String @default("active")

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consulting_package_overrides")
}

model AddonOverride {
  id String @id

  costBasis    Int?
  markupType   String @default("percent")
  markupValue  Int    @default(0)
  billingCycle String @default("annual")
  status       String @default("planned")

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addon_overrides")
}

model CommercialTermsOverride {
  id String @id @default("default")

  vatRate                Float
  revisionHourlyRate     Int
  revisionHourlyRateUsd  Int
  includedRevisionRounds Int
  paymentSplitFirst      Int
  paymentSplitSecond     Int
  paymentSplitFinal      Int
  proposalValidityDays   Int
  postLaunchWarrantyDays Int

  usdEgpRate        Int
  usdRateReviewedOn DateTime

  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commercial_terms_overrides")
}

model PricingChangeLog {
  id String @id @default(uuid())

  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?

  changedBy String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("pricing_change_log")
}

enum MaintenanceSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MaintenanceRequestStatus {
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model MaintenanceSubscription {
  id String @id @default(uuid())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  planId String

  status MaintenanceSubscriptionStatus @default(ACTIVE)

  portalToken String @unique @default(uuid())

  startedAt   DateTime  @default(now())
  cancelledAt DateTime?

  billingInterval BillingInterval @default(MONTHLY)

  quotedMonthlyPrice Int?

  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  autoRenew Boolean @default(true)

  trialEndsAt DateTime?

  lastRenewedAt DateTime?

  requests MaintenanceRequest[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("maintenance_subscriptions")
}

model MaintenanceRequest {
  id String @id @default(uuid())

  subscription   MaintenanceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String

  title  String
  detail String?

  status MaintenanceRequestStatus @default(SUBMITTED)

  cycleStart DateTime

  countsToCap Boolean @default(true)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, cycleStart])
  @@index([status])
  @@map("maintenance_requests")
}

enum ActorKind {
  USER
  CLIENT
  SYSTEM
  INTEGRATION
}

model ActivityEvent {
  id String @id @default(uuid())

  action String

  actorKind  ActorKind @default(SYSTEM)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorLabel String

  entityType  String
  entityId    String
  entityLabel String?

  summary String

  before Json?
  after  Json?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@map("activity_events")
}

enum ProductKind {
  WEBSITE
  WEB_APP
  API
  ECOMMERCE
  LANDING_PAGE
  INTERNAL_TOOL
}

enum ProductStatus {
  PLANNED
  IN_DEVELOPMENT
  LIVE
  MAINTENANCE
  SUNSET
}

enum DeployEnvironment {
  PRODUCTION
  STAGING
  PREVIEW
}

model Product {
  id String @id @default(uuid())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  name String
  slug String @unique

  kind   ProductKind   @default(WEBSITE)
  status ProductStatus @default(PLANNED)

  productionUrl String?
  stagingUrl    String?
  repositoryUrl String?

  framework       String?
  hostingProvider String?

  /// A site that was already running before it came to Altruvex OS (or is kept
  /// outside it): no CI pipeline is expected, so an empty deployment history reads
  /// as "not monitored" instead of "not connected". Anything that does report is
  /// still written and shown.
  existingSite Boolean @default(false)

  ingestTokenHash     String?   @unique
  ingestTokenLast4    String?
  ingestTokenIssuedAt DateTime?

  builds      Build[]
  deployments Deployment[]
  logs        LogEntry[]
  incidents   Incident[]
  services    ClientService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("products")
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Build {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  environment DeployEnvironment @default(PRODUCTION)
  status      BuildStatus       @default(QUEUED)

  number Int

  externalId String?

  commitSha     String?
  commitMessage String?
  branch        String?

  triggeredBy String?

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  failureReason String?

  deployments Deployment[]
  logs        LogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, number])
  @@unique([productId, externalId])
  @@index([productId, createdAt])
  @@index([status])
  @@map("builds")
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

model Deployment {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  build   Build?  @relation(fields: [buildId], references: [id], onDelete: SetNull)
  buildId String?

  environment DeployEnvironment @default(PRODUCTION)
  status      DeploymentStatus  @default(PENDING)

  number Int

  externalId String?

  version   String?
  commitSha String?
  url       String?

  triggeredBy String?

  startedAt  DateTime?
  finishedAt DateTime?

  rolledBackBy   Deployment?  @relation("Rollback", fields: [rolledBackById], references: [id], onDelete: SetNull)
  rolledBackById String?
  rollbackOf     Deployment[] @relation("Rollback")

  failureReason String?

  logs      LogEntry[]
  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, number])
  @@unique([productId, externalId])
  @@index([productId, createdAt])
  @@index([status])
  @@index([environment, createdAt])
  @@map("deployments")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model LogEntry {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  environment DeployEnvironment @default(PRODUCTION)
  level       LogLevel          @default(INFO)

  source  String?
  message String

  requestId String?

  timestamp DateTime @default(now())

  build   Build?  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String?

  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  deploymentId String?

  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  incidentId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([productId, timestamp])
  @@index([productId, level, timestamp])
  @@index([buildId, timestamp])
  @@index([deploymentId, timestamp])
  @@index([requestId])
  @@map("log_entries")
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Incident {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  deploymentId String?

  number Int

  title  String
  detail String?

  severity IncidentSeverity @default(SEV3)
  status   IncidentStatus   @default(INVESTIGATING)

  owner   User?   @relation("IncidentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  resolution String?

  updates IncidentUpdate[]
  logs    LogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, number])
  @@index([status, severity])
  @@index([productId, detectedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id String @id @default(uuid())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String

  status IncidentStatus?

  body String

  authorLabel String
  author      User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model ProjectTask {
  id String @id @default(uuid())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title  String
  detail String?

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  phase ProjectPhase?

  dueDate     DateTime?
  completedAt DateTime?

  position Int @default(0)

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@map("project_tasks")
}

enum EmailMessageStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  BOUNCED
  COMPLAINED
}

model EmailMessage {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  status EmailMessageStatus @default(QUEUED)

  providerMessageId String? @unique
  transport         String

  toAddress String
  subject   String
  body      String

  relatedProposalId String?
  relatedContractId String?

  failureReason String?

  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([providerMessageId])
  @@map("email_messages")
}

enum ClientServiceKind {
  DOMAIN
  HOSTING
  BUSINESS_EMAIL
  SSL_CERTIFICATE
  SOFTWARE_LICENSE
  OTHER
}

enum ClientServiceStatus {
  PENDING
  ACTIVE
  CANCELLED
}

model ClientService {
  id String @id @default(uuid())

  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalId String?

  kind      ClientServiceKind
  name      String
  provider  String?
  reference String?

  status ClientServiceStatus @default(PENDING)

  currency          String  @default("EGP")
  price             Int
  cost              Int?
  termMonths        Int?    @default(12)
  firstTermIncluded Boolean @default(false)
  autoRenew         Boolean @default(false)

  startedAt     DateTime?
  expiresAt     DateTime?
  lastRenewedAt DateTime?
  cancelledAt   DateTime?

  reminderSentFor DateTime?
  reminderSentAt  DateTime?

  payments Payment[]

  notes String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status, expiresAt])
  @@map("client_services")
}

enum ProductRole {
  OWNER
  ADMIN
  SALES
  PM
  FINANCE
  VIEWER
}

model ClientNote {
  id       String @id @default(uuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  author      User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  authorLabel String

  body   String
  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
  @@map("client_notes")
}
