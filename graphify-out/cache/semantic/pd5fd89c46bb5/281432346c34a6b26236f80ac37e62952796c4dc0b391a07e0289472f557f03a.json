{"nodes": [{"id": "apps_www_contents_articles_en_multilingual_architecture", "label": "Article (EN): Multi-language Web Architecture", "file_type": "document", "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_multilingual_architecture_translation_theater", "label": "Translation Theater anti-pattern", "file_type": "rationale", "rationale": "Translating text and adding dir=rtl is not localization; Arabic has different visual weight, scanning patterns, and technical requirements, so mirroring an English site produces a broken Arabic experience.", "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_multilingual_architecture_translation_tables", "label": "Translation tables database schema", "file_type": "rationale", "rationale": "Normalized per-language translation tables chosen over JSON columns because JSON cannot index efficiently, cannot enforce per-language content presence, and breaks relational integrity; translation tables allow adding a third language with no schema change and native indexed search.", "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_multilingual_architecture_subdirectory_url_strategy", "label": "Subdirectory URL locale strategy (/ar)", "file_type": "rationale", "rationale": "Subdirectory chosen over subdomain (splits domain authority, separate SSL, treated as separate site) and query parameter (weak SEO signals, poor caching); subdirectory consolidates authority and enables clean hreflang.", "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_multilingual_architecture_bilingual_stack", "label": "Altruvex bilingual stack (Next.js, TypeScript, Tailwind RTL variants, next-intl)", "file_type": "concept", "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}], "edges": [{"source": "apps_www_contents_articles_en_multilingual_architecture", "target": "apps_www_contents_articles_en_multilingual_architecture_translation_theater", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "weight": 1.0}, {"source": "apps_www_contents_articles_en_multilingual_architecture", "target": "apps_www_contents_articles_en_multilingual_architecture_translation_tables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "weight": 1.0}, {"source": "apps_www_contents_articles_en_multilingual_architecture", "target": "apps_www_contents_articles_en_multilingual_architecture_subdirectory_url_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "weight": 1.0}, {"source": "apps_www_contents_articles_en_multilingual_architecture", "target": "apps_www_contents_articles_en_multilingual_architecture_bilingual_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/www/contents/articles/en/multilingual-architecture.mdx", "source_location": null, "weight": 1.0},