{"nodes": [{"id": "apps_www_contents_articles_en_why_not_wordpress", "label": "Article (EN): Why We Don't Use WordPress", "file_type": "document", "source_file": "apps/www/contents/articles/en/why-not-wordpress.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_why_not_wordpress_plugin_architecture_fallacy", "label": "Plugin architecture fallacy", "file_type": "rationale", "rationale": "WordPress's 'plugin for everything' model makes black-box dependencies the foundation rather than a liability; a 30-plugin site is a Jenga tower with conflicting dependencies, update cascades, and abandoned code.", "source_file": "apps/www/contents/articles/en/why-not-wordpress.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_why_not_wordpress_eav_performance_tax", "label": "EAV performance tax (wp_postmeta)", "file_type": "rationale", "rationale": "WordPress's EAV metadata model trades flexibility for exponential query degradation at scale (800ms-2s multi-JOIN filters) versus 5-20ms on a normalized indexed PostgreSQL schema.", "source_file": "apps/www/contents/articles/en/why-not-wordpress.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_why_not_wordpress_fear_of_update_pattern", "label": "Fear of Update pattern", "file_type": "rationale", "rationale": "WordPress update cascades break themes and plugins, so owners stop updating to preserve stability, which is exactly when they become vulnerable to widely-published exploits.", "source_file": "apps/www/contents/articles/en/why-not-wordpress.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}], "edges": [{"source": "apps_www_contents_articles_en_w