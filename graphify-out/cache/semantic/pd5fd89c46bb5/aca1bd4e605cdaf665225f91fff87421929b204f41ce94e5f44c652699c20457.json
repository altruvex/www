{"nodes": [{"id": "apps_www_contents_articles_en_technical_debt", "label": "Article (EN): The Compound Interest of Technical Debt", "file_type": "document", "source_file": "apps/www/contents/articles/en/technical-debt.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_technical_debt_compound_interest_of_technical_debt", "label": "Compound interest of technical debt", "file_type": "rationale", "rationale": "Technical debt compounds unpredictably: the interest rate rises as the system evolves, debt begets more debt culturally, and every feature built on flawed foundations inherits the debt; quality code has an inverted interest rate and compounds as an asset.", "source_file": "apps/www/contents/articles/en/technical-debt.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_technical_debt_technical_bankruptcy", "label": "Technical bankruptcy (100% capacity on debt service)", "file_type": "concept", "source_file": "apps/www/contents/articles/en/technical-debt.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}, {"id": "apps_www_contents_articles_en_technical_debt_dependency_debt", "label": "Dependency debt (libraries as permanent liabilities)", "file_type": "rationale", "rationale": "Every dependency is owed maintenance forever (leftpad incident cited); Altruvex writes functionality in-house when it fits under ~200 lines and only takes dependencies for genuinely complex, actively maintained, security-vetted problems.", "source_file": "apps/www/contents/articles/en/technical-debt.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": "Altruvex Team", "contributor": null}], "edges": [{"source": "apps_www_contents_articles_en_technical_debt", "target": "apps_www_content