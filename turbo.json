{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "ADMIN_SECRET",
    "ADMIN_SECRET_PEPPER",
    "ADMIN_EMAIL",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_BUSINESS_ACCOUNT_ID",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
    "WHATSAPP_API_VERSION",
    "GITHUB_WEBHOOK_SECRET",
    "GITHUB_TOKEN",
    "GITHUB_ACCOUNT",
    "SLACK_WEBHOOK_URL",
    "NEXT_PUBLIC_APP_URL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_URL",
    "PUBLIC_SITE_URL",
    "PRICING_REVALIDATE_SECRET",
    "RESEND_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "EMAIL_FROM",
    "EMAIL_REPLY_TO",
    "ANALYZE",
    "APP_ENV",
    "BING_SITE_VERIFICATION",
    "GOOGLE_SITE_VERIFICATION",
    "INDEXNOW_KEY",
    "NEXT_PUBLIC_APP_VERSION",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "DELETE_FIXTURES"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "ADMIN_SECRET",
        "ADMIN_SECRET_PEPPER",
        "ADMIN_EMAIL",
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "WHATSAPP_BUSINESS_ACCOUNT_ID",
        "WHATSAPP_APP_SECRET",
        "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
        "WHATSAPP_API_VERSION",
        "GITHUB_WEBHOOK_SECRET",
        "GITHUB_TOKEN",
        "GITHUB_ACCOUNT",
        "SLACK_WEBHOOK_URL",
        "NEXT_PUBLIC_APP_URL",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "R2_PUBLIC_URL",
        "PUBLIC_SITE_URL",
        "PRICING_REVALIDATE_SECRET",
        "RESEND_API_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "ANALYZE",
        "APP_ENV",
        "BING_SITE_VERIFICATION",
        "GOOGLE_SITE_VERIFICATION",
        "INDEXNOW_KEY",
        "NEXT_PUBLIC_APP_VERSION",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "DELETE_FIXTURES"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "validate": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "@repo/database#build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        "generated/**"
      ]
    }
  }
}
