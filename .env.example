# Altruvex — environment reference
#
# Copy the lines you need into apps/admin/.env.local, apps/www/.env.local or
# packages/database/.env.local. Never commit a filled-in copy: every `.env*`
# file is ignored, and this file is the only one that is not.
#
# Values here are placeholders and are not valid credentials.

# ── Database (both apps + Prisma) ────────────────────────────────────────────
# Pooled connection, used by the running app. Production must say
# sslmode=verify-full: packages/database/index.ts refuses anything weaker,
# because `require` stops verifying the server certificate once pg drops its
# verify-full aliases. Use a least-privilege role, never the database owner.
DATABASE_URL="postgresql://app_user:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Direct (non-pooled) connection used only by `prisma migrate`. This is where
# the owner role belongs.
DIRECT_DATABASE_URL="postgresql://owner:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# ── Admin app: authentication ────────────────────────────────────────────────
# 32+ random bytes. `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-32-random-bytes"
# The admin app's own public origin, no trailing slash. Required in production:
# every client-facing link (sign, portal) is built on it rather than on the
# request's Host header.
BETTER_AUTH_URL="https://admin.example.com"
# Break-glass only. Two-factor enrolment is enforced unless this is "false".
ADMIN_MFA_REQUIRED="true"
# Used once, by `bun run seed:admin`, to create the first account.
ADMIN_EMAIL="you@example.com"
ADMIN_SECRET="the-first-admin-password"

# ── Admin app: integrations (all optional) ───────────────────────────────────
# WhatsApp Business. Without WHATSAPP_APP_SECRET the webhook refuses every
# payload in production.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# GitHub. The webhook secret is the receiver's whole authenticity check.
GITHUB_WEBHOOK_SECRET=""
GITHUB_TOKEN=""
GITHUB_ACCOUNT=""

# Slack: one incoming webhook URL is the entire integration.
SLACK_WEBHOOK_URL=""

# Mail. Resend wins when both are set; with neither, nothing pretends to send.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Altruvex <hello@example.com>"
EMAIL_REPLY_TO="hello@example.com"

# Cloudflare R2. Set R2_PRIVATE=true to store documents privately and hand out
# short-lived signed links; leave it unset only while the bucket is public.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_PRIVATE="true"

# The scheduler's credential for /api/cron/*. Without it the sweep refuses.
CRON_SECRET=""

# ── Cross-app ────────────────────────────────────────────────────────────────
# Lets an admin price change drop the public site's cache immediately rather
# than on its timer. Both optional; 16 characters minimum.
PUBLIC_SITE_URL="https://example.com"
PRICING_REVALIDATE_SECRET=""

# ── Marketing site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://example.com"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
INDEXNOW_KEY=""
