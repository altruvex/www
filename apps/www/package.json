{
  "name": "www",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/font-licenses.mjs && next dev --port 3010",
    "build": "node scripts/font-licenses.mjs && node scripts/font-licenses.mjs --check && next build",
    "analyze": "node scripts/font-licenses.mjs && cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "check-types": "node node_modules/typescript7/bin/tsc --noEmit",
    "knip": "knip --no-config-hints",
    "indexnow:submit": "bun scripts/indexnow-submit.js",
    "check:font-licenses": "node scripts/font-licenses.mjs --check",
    "check:bidi": "node scripts/check-bidi.mjs",
    "check:line-height": "node scripts/check-line-height.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@radix-ui/react-slot": "^1.2.4",
    "@repo/brand-font": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/pricing-schema": "workspace:*",
    "@repo/ui": "workspace:*",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.19",
    "lucide-react": "^0.562.0",
    "next": "^16.3.8",
    "next-intl": "^4.13.1",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "knip": "^5.61.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
